<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>FSharpEventAddons</AssemblyName>
    <RootNamespace>FSharpEventAddons</RootNamespace>
    
    <!-- Package Metadata -->
    <PackageId>FSharpEventAddons</PackageId>
    <Version>1.0.0</Version>
    <Authors>Pac-Dessert1436</Authors>
    <Company></Company>
    <Description>A functional programming-inspired event scheduling library for F# with priority, delayed, and periodic event schedulers.</Description>
    <PackageTags>fsharp;functional-programming;events;scheduling;priority;delayed;periodic</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Pac-Dessert1436/FSharpEventAddons</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Pac-Dessert1436/FSharpEventAddons</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Library.fs" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>